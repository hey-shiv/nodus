# Copy to .env (never committed) and fill in what you use. Everything is optional:
# the matching engine and demo need no LLM at all.

# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models tried in order (first one with quota left wins)
NODUS_GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Local fallback via Ollama (ollama pull gemma4:12b-it-qat)
NODUS_OLLAMA_MODEL=gemma4:12b-it-qat

# FalkorDB connection
NODUS_DB_HOST=localhost
NODUS_DB_PORT=6379
NODUS_GRAPH=nodus
